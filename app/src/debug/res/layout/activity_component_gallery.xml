<?xml version="1.0" encoding="utf-8"?>
<!-- Debug component gallery implementing redesign Part F3 for real-device comparison. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/gallery_title" android:textAppearance="@style/TextAppearance.PetCare.Display" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" android:text="@string/gallery_subtitle"
            android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_16">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/gallery_next_up" android:textAppearance="@style/TextAppearance.PetCare.Label"
                    android:textColor="@color/text_secondary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" android:text="@string/gallery_task"
                    android:textAppearance="@style/TextAppearance.PetCare.Headline" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" android:text="@string/gallery_countdown"
                    android:textAppearance="@style/TextAppearance.PetCare.Countdown" />
                <com.example.petcare.ui.home.SegmentedProgressView android:id="@+id/gallery_segments"
                    android:layout_width="match_parent" android:layout_height="@dimen/space_8"
                    android:layout_marginTop="@dimen/space_16" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32" android:text="@string/gallery_avatar"
            android:textAppearance="@style/TextAppearance.PetCare.Title" />
        <com.example.petcare.ui.PetAvatarView android:id="@+id/gallery_pet_avatar"
            android:layout_width="@dimen/pet_filter_avatar" android:layout_height="@dimen/pet_filter_avatar"
            android:layout_marginTop="@dimen/space_12" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/timeline_row_min_height"
            android:layout_marginTop="@dimen/space_16" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="@dimen/timeline_time_width" android:layout_height="wrap_content"
                android:text="@string/gallery_time" android:textAppearance="@style/TextAppearance.PetCare.Figure" />
            <TextView android:layout_width="@dimen/timeline_node_size" android:layout_height="@dimen/timeline_node_size"
                android:background="@drawable/bg_now_dot" android:gravity="center" android:text="@string/gallery_check"
                android:textColor="@color/on_primary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/gallery_task" android:textAppearance="@style/TextAppearance.PetCare.RowTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/gallery_task_detail" android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32" android:text="@string/gallery_buttons"
            android:textAppearance="@style/TextAppearance.PetCare.Title" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.PetCare.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/gallery_primary" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.PetCare.Button.Tonal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/gallery_secondary" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.PetCare.Button.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/gallery_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" android:text="@string/gallery_inputs"
            android:textAppearance="@style/TextAppearance.PetCare.Title" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:hint="@string/gallery_pet_name">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:checkable="true" android:text="@string/gallery_chip_all" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/gallery_chip_max" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_24">
                <ImageView android:layout_width="@dimen/space_48" android:layout_height="@dimen/space_48" android:contentDescription="@null" android:src="@drawable/ic_pets" app:tint="@color/text_secondary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/gallery_empty_title" android:textAppearance="@style/TextAppearance.PetCare.Title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:text="@string/gallery_empty_body" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
