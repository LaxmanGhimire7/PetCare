<?xml version="1.0" encoding="utf-8"?>
<!-- PetCare design kit: component styles, matched to the approved mockup. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Plain TextViews default to Body; an explicit android:textAppearance on the view still wins. -->
    <style name="Widget.PC.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.PC.Body</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.PC.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.PC.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.PC.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.PC.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.PC.SheetTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.PC.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">13dp</item>
    </style>

    <!-- 40dp pill, orange fill, BLACK label. White on this orange fails contrast. -->
    <style name="Widget.PC.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pc_primary</item>
        <item name="android:textColor">@color/pc_on_primary</item>
        <item name="iconTint">@color/pc_on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Pill</item>
        <item name="rippleColor">#33000000</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PC.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/pc_surface_muted</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="iconTint">@color/pc_text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Pill</item>
        <item name="elevation">0dp</item>
    </style>

    <!--
        "Continue with Google", following Google's sign-in branding guidelines:
        neutral fill, grey outline, Roboto Medium, the official "G" logo in its own colours.
    -->
    <style name="Widget.PC.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/pc_google_fill</item>
        <item name="strokeColor">@color/pc_google_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/pc_google_text</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.GoogleButton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="icon">@drawable/pc_ic_google</item>
        <item name="iconTint">@null</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Pill</item>
    </style>

    <!-- Compact secondary button for card actions (Share again, Call, Directions). -->
    <style name="Widget.PC.Button.Compact" parent="Widget.PC.Button.Secondary">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconSize">15dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.LabelStrong</item>
    </style>

    <!-- One option in a segmented control (Once / Daily / Weekly / Monthly). -->
    <style name="Widget.PC.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/pc_segment_bg</item>
        <item name="android:textColor">@color/pc_segment_text</item>
        <item name="strokeColor">@color/pc_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="Widget.PC.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/pc_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 52dp square-ish FAB with an 18dp corner and a black plus. -->
    <style name="Widget.PC.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/pc_primary</item>
        <item name="tint">@color/pc_on_primary</item>
        <item name="fabCustomSize">52dp</item>
        <item name="maxImageSize">24dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PC.Fab</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <style name="Widget.PC.ExtendedFAB" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/pc_primary</item>
        <item name="android:textColor">@color/pc_on_primary</item>
        <item name="iconTint">@color/pc_on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.Button</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PC.Fab</item>
    </style>

    <!--
        Bottom navigation: 64dp, black, hairline on top, 44x26 orange-tinted active pill.
        It applies the system bottom inset ITSELF, so do not add any insets listener,
        padding or fixed height to it in layouts or code.
    -->
    <style name="Widget.PC.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/pc_bg_nav</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">20dp</item>
        <item name="itemIconTint">@color/pc_nav_icon</item>
        <item name="itemTextColor">@color/pc_nav_text</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PC.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PC.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PC.BottomNav.Indicator</item>
    </style>
    <style name="Widget.PC.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/pc_primary_container</item>
        <item name="android:width">44dp</item>
        <item name="android:height">26dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.NavIndicator</item>
    </style>
    <!-- Belt and braces: also shrink Material's default 80dp navigation bar height. -->
    <dimen name="m3_bottom_nav_min_height" tools:ignore="PrivateResource">64dp</dimen>

    <!-- Inputs: filled, no underline or outline. Set the hint ONLY on the TextInputLayout. -->
    <style name="Widget.PC.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/pc_surface_muted</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Input</item>
        <item name="hintTextColor">@color/pc_primary_text</item>
        <item name="android:textColorHint">@color/pc_text_secondary</item>
        <item name="hintTextAppearance">@style/TextAppearance.PC.Label</item>
        <item name="startIconTint">@color/pc_text_secondary</item>
        <item name="endIconTint">@color/pc_text_secondary</item>
        <item name="errorTextAppearance">@style/TextAppearance.PC.Meta</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.PC.Meta</item>
    </style>

    <!--
        Exposed dropdown (e.g. "Saved place", "Security question"). Put the hint on the
        TextInputLayout ONLY, never on the AutoCompleteTextView inside it, or the label and
        the value draw on top of each other.
    -->
    <style name="Widget.PC.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/pc_surface_muted</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Input</item>
        <item name="hintTextColor">@color/pc_primary_text</item>
        <item name="android:textColorHint">@color/pc_text_secondary</item>
        <item name="hintTextAppearance">@style/TextAppearance.PC.Label</item>
        <item name="endIconTint">@color/pc_text_secondary</item>
    </style>

    <!-- Filter chips: filled, no outline, orange with a black label when selected. -->
    <style name="Widget.PC.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pc_chip_bg</item>
        <item name="android:textColor">@color/pc_chip_text</item>
        <item name="chipIconTint">@color/pc_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.PC.Chip</item>
    </style>

    <!-- Toolbars: left-aligned condensed title, no tint. -->
    <style name="Widget.PC.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/pc_canvas</item>
        <item name="titleTextAppearance">@style/TextAppearance.PC.Headline</item>
        <item name="navigationIconTint">@color/pc_text_primary</item>
    </style>

    <!-- Dialogs: raised surface, condensed title, quiet text buttons. -->
    <style name="ThemeOverlay.PC.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Widget.PC.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.PC.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.PC.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PC.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PC.Button.Text</item>
    </style>
    <style name="Widget.PC.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/pc_surface_raised</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Card</item>
    </style>
    <style name="Widget.PC.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.PC.Headline</item>
        <item name="android:textColor">@color/pc_text_primary</item>
    </style>
    <style name="Widget.PC.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.PC.Body</item>
        <item name="android:textColor">@color/pc_text_secondary</item>
    </style>

    <style name="Widget.PC.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/pc_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.Card</item>
    </style>

    <style name="ThemeOverlay.PC.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PC.BottomSheet</item>
    </style>
    <style name="Widget.PC.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/pc_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PC.SheetTop</item>
    </style>
</resources>
