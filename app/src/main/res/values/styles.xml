<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PetCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.PetCare.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_container_low</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">@color/outline_variant</item>
    </style>

    <style name="Widget.PetCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container_low</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PetCare.Button.Tool" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">74dp</item><item name="cornerRadius">20dp</item>
        <item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item><item name="iconPadding">10dp</item><item name="iconSize">22dp</item>
    </style>

    <style name="Widget.PetCare.Button.HeroPrimary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item><item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/hero_button</item><item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.Button.HeroSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item><item name="cornerRadius">18dp</item>
        <item name="android:textColor">@color/on_hero</item><item name="iconTint">@color/on_hero</item>
        <item name="strokeColor">@color/hero_muted</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item>
    </style>
</resources>
