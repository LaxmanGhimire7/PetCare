<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PetCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.PetCare.RowTitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.PetCare.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/surface_muted</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAppearance">@style/TextAppearance.PetCare.RowTitle</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetCare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.PetCare.RowTitle</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Flat grouped-list row used by Settings without adding individual card shadows. -->
    <style name="Widget.PetCare.SettingsRow" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textAppearance">@style/TextAppearance.PetCare.RowTitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_16</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="Widget.PetCare.SettingsRow.Destructive" parent="Widget.PetCare.SettingsRow">
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
    </style>

    <!-- Consistent section caption above every Settings group. -->
    <style name="SettingsSectionTitle" parent="TextAppearance.PetCare.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_28</item>
        <item name="android:layout_marginBottom">@dimen/space_10</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Shared spacing for the two grouped sections on Money. -->
    <style name="MoneySectionTitle" parent="TextAppearance.PetCare.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_28</item>
        <item name="android:layout_marginBottom">@dimen/space_10</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Equal-width figure block on pet detail. -->
    <style name="PetDetailStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="PetDetailStatValue" parent="TextAppearance.PetCare.Amount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="PetDetailStatLabel" parent="TextAppearance.PetCare.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 56dp icon well used by the Today quick action row. -->
    <style name="Widget.PetCare.QuickActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_muted</item><item name="iconTint">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_icon_well</item><item name="iconPadding">0dp</item>
        <item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item>
        <item name="android:minWidth">@dimen/quick_action_size</item><item name="android:minHeight">@dimen/quick_action_size</item>
    </style>

    <!-- Circular completion control placed inside a 48dp touch target. -->
    <style name="Widget.PetCare.TaskCheckbox" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_pill</item><item name="strokeWidth">@dimen/task_checkbox_stroke</item>
        <item name="android:insetLeft">@dimen/space_12</item><item name="android:insetRight">@dimen/space_12</item>
        <item name="android:insetTop">@dimen/space_12</item><item name="android:insetBottom">@dimen/space_12</item>
        <item name="iconPadding">0dp</item><item name="android:minWidth">@dimen/touch_target</item><item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.PetCare.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/surface_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeWidth">0dp</item><item name="boxStrokeWidthFocused">0dp</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="hintTextAppearance">@style/TextAppearance.PetCare.Supporting</item>
    </style>

    <!-- Filled exposed menu with the same inset and label geometry as every field. -->
    <style name="Widget.PetCare.TextInput.Dropdown" parent="Widget.PetCare.TextInput">
        <item name="endIconMode">dropdown_menu</item>
    </style>

    <style name="Widget.PetCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Squared-off floating action shape used by the instrument-inspired Today screen. -->
    <style name="ShapeAppearance.PetCare.Fab" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_icon_well</item>
    </style>

</resources>
