<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation background: canvas colour with a hairline along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_hairline" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_canvas" />
        </shape>
    </item>
</layer-list>
