<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud and device transfers preserve care records but never transfer unlock state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="petcare_auth.xml" />
        <exclude domain="sharedpref" path="petcare_biometric.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="petcare_auth.xml" />
        <exclude domain="sharedpref" path="petcare_biometric.xml" />
    </device-transfer>
</data-extraction-rules>
