<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick actions: four equal tiles so they never overflow.
    Share = SMS delegation (a core requirement), one tap from Today.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/pcActionShare"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pc_a11y_share_checklist"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/pc_bg_icon_well"
            android:importantForAccessibility="no"
            android:padding="15dp"
            android:src="@drawable/pc_ic_share"
            app:tint="@color/pc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:text="@string/pc_action_share"
            android:textAppearance="@style/TextAppearance.PC.Label" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pcActionRoutine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pc_a11y_new_routine"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/pc_bg_icon_well"
            android:importantForAccessibility="no"
            android:padding="15dp"
            android:src="@drawable/pc_ic_checklist"
            app:tint="@color/pc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:text="@string/pc_action_routine"
            android:textAppearance="@style/TextAppearance.PC.Label" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pcActionImport"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pc_a11y_import"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/pc_bg_icon_well"
            android:importantForAccessibility="no"
            android:padding="15dp"
            android:src="@drawable/pc_ic_import"
            app:tint="@color/pc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:text="@string/pc_action_import"
            android:textAppearance="@style/TextAppearance.PC.Label" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pcActionExport"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pc_a11y_export"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/pc_bg_icon_well"
            android:importantForAccessibility="no"
            android:padding="15dp"
            android:src="@drawable/pc_ic_export"
            app:tint="@color/pc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:text="@string/pc_action_export"
            android:textAppearance="@style/TextAppearance.PC.Label" />
    </LinearLayout>
</LinearLayout>
