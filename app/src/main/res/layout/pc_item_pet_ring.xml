<?xml version="1.0" encoding="utf-8"?>
<!-- One pet in the ring row: species icon inside a progress ring, name, and "2 of 3". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="58dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <com.example.petcare.design.PetRingView
            android:id="@+id/pcRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/pcRingPhoto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:background="@drawable/pc_bg_oval"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pcRingIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:background="@drawable/pc_bg_oval"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/pc_ic_paw"
            tools:tint="@color/pc_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/pcRingName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PC.Label"
        tools:text="Max" />

    <TextView
        android:id="@+id/pcRingCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.PC.FigureSmall"
        android:textColor="@color/pc_text_secondary"
        tools:text="2 of 3" />
</LinearLayout>
