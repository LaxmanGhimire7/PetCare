<?xml version="1.0" encoding="utf-8"?>
<!--
    Pets screen, matched to the approved mockup: two-column grid, a dashed "Add a pet" row,
    what's coming this week, and this month's spending.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pcPetsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/pc_your_pets"
                    android:textAppearance="@style/TextAppearance.PC.Display" />

                <ImageButton
                    android:id="@+id/pcPetsAdd"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/pc_bg_icon_button"
                    android:contentDescription="@string/pc_add_pet"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pc_ic_plus"
                    app:tint="@color/pc_text_primary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pcPetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="7dp"
                android:paddingEnd="7dp" />

            <TextView
                android:id="@+id/pcComingUpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/pc_coming_up"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pcComingUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pc_bg_surface_18"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/pcComingUpEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/pc_coming_up_empty"
                android:textAppearance="@style/TextAppearance.PC.Supporting"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pcMonthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/pc_this_month"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <include
                android:id="@+id/pcMonth"
                layout="@layout/pc_view_month_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
