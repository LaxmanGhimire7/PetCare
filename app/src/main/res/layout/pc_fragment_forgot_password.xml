<?xml version="1.0" encoding="utf-8"?>
<!-- Reset password in three steps: find account, answer security question, choose a new password. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcResetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/pcResetBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/pc_bg_icon_button"
            android:contentDescription="@string/pc_a11y_back"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pc_ic_back"
            app:tint="@color/pc_text_primary" />

        <com.example.petcare.design.SegmentedBarView
            android:id="@+id/pcResetSteps"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/pcResetStepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.PC.Meta"
            tools:text="Step 1 of 3" />

        <!-- Step 1: find the account. -->
        <LinearLayout
            android:id="@+id/pcResetStepEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:includeFontPadding="false"
                android:text="@string/pc_reset_title"
                android:textAppearance="@style/TextAppearance.PC.Display" />
    
            <TextView
                android:id="@+id/pcResetEmailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_reset_body"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcResetEmailLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_email"
                app:startIconDrawable="@drawable/pc_ic_mail">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcResetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcResetEmailNext"
                style="@style/Widget.PC.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/pc_continue" />
        </LinearLayout>

        <!-- Step 2: answer the security question. -->
        <LinearLayout
            android:id="@+id/pcResetStepAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:includeFontPadding="false"
                android:text="@string/pc_security_check"
                android:textAppearance="@style/TextAppearance.PC.Display" />
    
            <TextView
                android:id="@+id/pcResetAnswerBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_security_check_body"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/pc_bg_surface_18"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/pc_ic_shield"
                    app:tint="@color/pc_primary_text" />

                <TextView
                    android:id="@+id/pcResetQuestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.PC.RowTitle"
                    tools:text="What was the name of your first pet?" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcResetAnswerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_security_answer"
                app:startIconDrawable="@drawable/pc_ic_key">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcResetAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcResetAnswerNext"
                style="@style/Widget.PC.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/pc_verify" />
        </LinearLayout>

        <!-- Step 3: choose a new password. -->
        <LinearLayout
            android:id="@+id/pcResetStepPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:includeFontPadding="false"
                android:text="@string/pc_new_password"
                android:textAppearance="@style/TextAppearance.PC.Display" />
    
            <TextView
                android:id="@+id/pcResetPasswordBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_new_password_body"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcResetPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_new_password"
                app:startIconDrawable="@drawable/pc_ic_lock"
                app:endIconMode="password_toggle">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/pcResetStrength"
                layout="@layout/pc_view_password_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcResetConfirmLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_confirm_password"
                app:startIconDrawable="@drawable/pc_ic_lock"
                app:endIconMode="password_toggle">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcResetConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcResetSave"
                style="@style/Widget.PC.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="@string/pc_save_password" />
        </LinearLayout>

        <!-- Done. -->
        <LinearLayout
            android:id="@+id/pcResetDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/pc_bg_success_well"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/pc_ic_circle_check"
                app:tint="@color/pc_success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pc_reset_done_title"
                android:textAppearance="@style/TextAppearance.PC.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_reset_done_body"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcResetBackToLogin"
                style="@style/Widget.PC.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:text="@string/pc_back_to_login" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
