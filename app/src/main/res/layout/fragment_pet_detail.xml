<?xml version="1.0" encoding="utf-8"?>
<!-- Pet detail shows the selected animal's photo and care profile in its identity colour. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pet_detail_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/space_20">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_button" style="@style/Widget.PetCare.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/back" />
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pet_pager" android:layout_width="match_parent"
                android:layout_height="@dimen/pet_detail_photo_height"
                android:layout_marginTop="@dimen/space_16"
                android:background="?attr/colorSurfaceContainer" />
            <TextView android:id="@+id/pet_page_count"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.PetCare.Label"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <View android:id="@+id/pet_color_rail" android:layout_width="@dimen/space_32"
                android:layout_height="@dimen/space_4" android:layout_marginTop="@dimen/space_24" />
            <TextView android:id="@+id/pet_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.PetCare.Display" />
            <TextView android:id="@+id/pet_species" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.PetCare.Title"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/pet_health" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24"
                android:textAppearance="@style/TextAppearance.PetCare.Body" />
            <TextView android:id="@+id/pet_allergies" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.PetCare.Body" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_pet_button" style="@style/Widget.PetCare.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/edit_pet_title" app:icon="@drawable/ic_edit" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
