<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane pet detail: swipeable hero, overlaid identity, figures, and profile tabs. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pet_detail_card" android:layout_width="match_parent"
    android:layout_height="match_parent" app:cardBackgroundColor="@color/canvas"
    app:cardCornerRadius="@dimen/layout_zero" app:cardElevation="@dimen/layout_zero">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="@dimen/fab_clearance">
            <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/pet_detail_hero_height">
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pet_pager"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" />
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_pet_hero_scrim" />
                <com.google.android.material.button.MaterialButton android:id="@+id/back_button"
                    style="@style/Widget.PetCare.Button.Text" android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target" android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_16" android:contentDescription="@string/back"
                    android:rotation="180" android:text="" app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="textStart" app:iconTint="@color/text_primary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_20" android:paddingBottom="@dimen/space_20">
                    <TextView android:id="@+id/pet_page_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Label"
                        android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/pet_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.PetCare.Display" android:textColor="@android:color/white" />
                    <TextView android:id="@+id/pet_species" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.PetCare.Supporting" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </FrameLayout>
            <View android:id="@+id/pet_color_rail" android:layout_width="@dimen/space_4"
                android:layout_height="@dimen/space_4" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="@dimen/space_20"
                android:paddingVertical="@dimen/space_20" android:weightSum="3">
                <LinearLayout style="@style/PetDetailStat" android:layout_weight="1">
                    <TextView android:id="@+id/pet_age_stat" style="@style/PetDetailStatValue" />
                    <TextView style="@style/PetDetailStatLabel" android:text="@string/pet_age_stat" />
                </LinearLayout>
                <LinearLayout style="@style/PetDetailStat" android:layout_weight="1">
                    <TextView android:id="@+id/pet_weight_stat" style="@style/PetDetailStatValue" />
                    <TextView style="@style/PetDetailStatLabel" android:text="@string/pet_weight_stat" />
                </LinearLayout>
                <LinearLayout style="@style/PetDetailStat" android:layout_weight="1">
                    <TextView android:id="@+id/pet_done_stat" style="@style/PetDetailStatValue" />
                    <TextView style="@style/PetDetailStatLabel" android:text="@string/pet_done_today_stat" />
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_20" android:scrollbars="none">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:selectionRequired="true" app:singleSelection="true" app:checkedButton="@id/pet_tab_care">
                    <com.google.android.material.button.MaterialButton android:id="@+id/pet_tab_care"
                        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pet_tab_care" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pet_tab_health"
                        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pet_tab_health" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pet_tab_profile"
                        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pet_tab_profile" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pet_tab_spending"
                        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pet_tab_spending" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_20" android:layout_marginTop="@dimen/space_20">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_16">
                    <TextView android:id="@+id/pet_health" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Body" />
                    <TextView android:id="@+id/pet_allergies" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
                        android:textAppearance="@style/TextAppearance.PetCare.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/share_checklist_button"
                style="@style/Widget.PC.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_20"
                android:layout_marginTop="@dimen/space_20" android:text="@string/share_checklist"
                app:icon="@drawable/pc_ic_share" app:iconTint="@color/pc_text_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/edit_pet_button"
                style="@style/Widget.PetCare.Button.Tonal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_20"
                android:layout_marginTop="@dimen/space_20" android:text="@string/edit_pet_title" app:icon="@drawable/ic_edit" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
