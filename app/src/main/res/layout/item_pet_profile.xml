<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane pet grid card: photo/species fallback, progress badge and care summary. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_4"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/layout_zero">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/space_12">
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/pet_grid_photo_height" android:layout_margin="@dimen/space_8">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="@dimen/radius_input" app:cardElevation="@dimen/layout_zero">
                <ImageView android:id="@+id/pet_photo_image" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/pet_photo" android:scaleType="centerCrop" />
                <TextView android:id="@+id/pet_initial_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:importantForAccessibility="no" android:textAppearance="@style/TextAppearance.PetCare.Display" />
            </com.google.android.material.card.MaterialCardView>
            <com.example.petcare.ui.PetAvatarView android:id="@+id/pet_progress_badge" android:layout_width="@dimen/pet_badge_size" android:layout_height="@dimen/pet_badge_size" android:layout_gravity="top|end" android:layout_margin="@dimen/space_8" android:background="@color/surface" />
        </FrameLayout>
        <TextView android:id="@+id/pet_name_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_12" android:textAppearance="@style/TextAppearance.PetCare.CardTitle" />
        <TextView android:id="@+id/pet_species_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_12" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
        <TextView android:id="@+id/pet_health_notes_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:paddingHorizontal="@dimen/space_12" android:text="@string/pet_no_tasks_today" android:textAppearance="@style/TextAppearance.PetCare.Label" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
