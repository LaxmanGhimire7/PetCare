<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane Money destination: month total, trend, pet filters, categories, and editable recent costs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_20"
            android:paddingBottom="@dimen/fab_clearance">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/nav_money"
                    android:textAppearance="@style/TextAppearance.PetCare.Display" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/month_button" style="@style/Widget.PetCare.Button.Text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PetCare.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_16">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/money_spent_this_month"
                        android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView android:id="@+id/total_text" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.PetCare.Amount" />
                    <TextView android:id="@+id/change_text" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <LinearLayout android:id="@+id/pet_split_bar" android:layout_width="match_parent"
                        android:layout_height="@dimen/money_split_height" android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/pet_filter_group" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16"
                app:selectionRequired="true" app:singleSelection="true" />

            <com.example.petcare.ui.expenses.ExpenseInsightsView
                android:id="@+id/insights_view" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" />

            <TextView style="@style/MoneySectionTitle" android:text="@string/money_by_category" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/category_container" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/MoneySectionTitle" android:text="@string/money_recent" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/recent_container" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/empty_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:padding="@dimen/space_32" android:text="@string/expense_empty"
                android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20" android:gravity="center" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/export_csv_button"
                    style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/export_expenses_csv" />
                <com.google.android.material.button.MaterialButton android:id="@+id/export_pdf_button"
                    style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/export_expenses_pdf" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_button" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="@dimen/space_20"
        android:text="@string/add_expense" android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary" app:icon="@drawable/ic_add" app:iconTint="@color/on_primary" />
</FrameLayout>
