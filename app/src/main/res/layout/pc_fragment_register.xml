<?xml version="1.0" encoding="utf-8"?>
<!-- Create account: strength-checked password and a security question for password reset. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcRegisterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/pcRegisterBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/pc_bg_icon_button"
            android:contentDescription="@string/pc_a11y_back"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pc_ic_back"
            app:tint="@color/pc_text_primary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:includeFontPadding="false"
            android:text="@string/pc_register_title"
            android:textAppearance="@style/TextAppearance.PC.Display" />

        <TextView
            android:id="@+id/pcRegisterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pc_register_body"
            android:textAppearance="@style/TextAppearance.PC.Supporting" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcRegisterGoogle"
            style="@style/Widget.PC.Button.Google"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/pc_continue_google"
            android:visibility="gone" />

        <include
            android:id="@+id/pcRegisterOr"
            layout="@layout/pc_view_or_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterNameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_name"
            app:startIconDrawable="@drawable/pc_ic_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterEmailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_email"
            app:startIconDrawable="@drawable/pc_ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterPhoneLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_phone"
            app:startIconDrawable="@drawable/pc_ic_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_password"
            app:startIconDrawable="@drawable/pc_ic_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/pcRegisterStrength"
            layout="@layout/pc_view_password_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterConfirmLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_confirm_password"
            app:startIconDrawable="@drawable/pc_ic_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/pc_account_recovery"
            android:textAppearance="@style/TextAppearance.PC.Section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pc_account_recovery_body"
            android:textAppearance="@style/TextAppearance.PC.Supporting" />

        <!-- Hint lives on the layout only, never on the AutoCompleteTextView. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterQuestionLayout"
            style="@style/Widget.PC.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_security_question"
            app:startIconDrawable="@drawable/pc_ic_shield">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/pcRegisterQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pcRegisterAnswerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pc_security_answer"
            app:startIconDrawable="@drawable/pc_ic_key">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pcRegisterAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcRegisterSubmit"
            style="@style/Widget.PC.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/pc_create_account" />
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_have_account"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcRegisterLogIn"
                style="@style/Widget.PC.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_log_in" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
