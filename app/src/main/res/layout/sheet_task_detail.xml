<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane task detail sheet with a readable peek and grouped care information. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_sheet"
    android:minHeight="@dimen/task_detail_sheet_min_height"
    android:orientation="vertical"
    android:padding="@dimen/space_20">
    <View android:layout_width="@dimen/space_32" android:layout_height="@dimen/space_4" android:layout_gravity="center_horizontal" android:background="@color/hairline" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/task_title" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.PetCare.Headline" />
        <com.google.android.material.button.MaterialButton android:id="@+id/task_more_button" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="@dimen/space_40" android:layout_height="@dimen/space_40" android:contentDescription="@string/task_options" app:backgroundTint="@color/surface_raised" app:icon="@drawable/ic_more" app:iconTint="@color/text_primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
        <TextView android:id="@+id/task_pet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_8" android:paddingVertical="@dimen/space_4" android:textAppearance="@style/TextAppearance.PetCare.Label" />
        <TextView android:id="@+id/task_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
    </LinearLayout>
    <TextView android:id="@+id/task_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:textAppearance="@style/TextAppearance.PetCare.Countdown" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="@dimen/radius_icon_well" app:cardElevation="@dimen/layout_zero">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16">
            <TextView android:id="@+id/task_supplies" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Body" />
            <TextView android:id="@+id/task_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:textAppearance="@style/TextAppearance.PetCare.Body" />
            <FrameLayout android:id="@+id/task_map_preview" android:layout_width="match_parent" android:layout_height="@dimen/place_preview_height" android:layout_marginTop="@dimen/space_16" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/task_directions_button" style="@style/Widget.PetCare.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/directions" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/task_calendar_button" style="@style/Widget.PetCare.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_to_calendar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/task_mark_done_button" style="@style/Widget.PetCare.Button.Primary" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mark_done" app:icon="@drawable/ic_check" />
        <com.google.android.material.button.MaterialButton android:id="@+id/task_share_button" style="@style/Widget.PetCare.Button.Tonal" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:text="@string/share_list" app:icon="@drawable/pc_ic_share" />
    </LinearLayout>
</LinearLayout>
