<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane chronological timeline row. The node is the completion control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/now_marker_container" android:layout_width="match_parent" android:layout_height="@dimen/space_40" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/now_time_text" android:layout_width="@dimen/timeline_time_width" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Figure" android:textColor="@color/primary_text" />
        <View android:layout_width="@dimen/space_8" android:layout_height="@dimen/space_8" android:layout_marginHorizontal="@dimen/space_8" android:background="@drawable/bg_now_dot" />
        <View android:layout_width="@dimen/layout_zero" android:layout_height="@dimen/timeline_connector_width" android:layout_weight="1" android:background="@color/primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:text="@string/now" android:textAppearance="@style/TextAppearance.PetCare.Label" android:textColor="@color/primary_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:minHeight="@dimen/timeline_row_min_height"
        android:orientation="horizontal">

        <TextView android:id="@+id/task_time_text" android:layout_width="@dimen/timeline_time_width" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="end" android:maxLines="2" android:textAppearance="@style/TextAppearance.PetCare.Figure" />
        <TextView android:id="@+id/task_due_date_text" android:layout_width="@dimen/timeline_time_width" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:maxLines="2" android:textAppearance="@style/TextAppearance.PetCare.Supporting" android:visibility="gone" />

        <FrameLayout android:layout_width="@dimen/touch_target" android:layout_height="match_parent" android:minHeight="@dimen/timeline_row_min_height">
            <View android:id="@+id/task_connector" android:layout_width="@dimen/timeline_connector_width" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_32" android:background="@color/hairline" />
            <com.google.android.material.button.MaterialButton android:id="@+id/complete_task_button" style="@style/Widget.PetCare.TaskCheckbox" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:contentDescription="@string/task_done_content_description" />
        </FrameLayout>

        <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_4" android:layout_weight="1" android:orientation="vertical" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_12">
            <TextView android:id="@+id/task_title_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.PetCare.RowTitle" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:id="@+id/task_pet_dot" android:layout_width="@dimen/layout_6_dp" android:layout_height="@dimen/layout_6_dp" />
                <TextView android:id="@+id/task_pet_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_4" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                <ImageView android:id="@+id/task_category_icon" android:layout_width="@dimen/layout_14_dp" android:layout_height="@dimen/layout_14_dp" android:layout_marginStart="@dimen/space_8" android:contentDescription="@null" android:src="@drawable/ic_pets" app:tint="@color/text_secondary" />
                <ImageView android:id="@+id/task_location_chip" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:layout_marginStart="@dimen/space_4" android:contentDescription="@string/location_chip" android:padding="@dimen/layout_14_dp" android:src="@drawable/ic_location" android:visibility="gone" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/task_overdue_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:text="@string/overdue" android:textAppearance="@style/TextAppearance.PetCare.Label" android:textColor="@color/error" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView android:id="@+id/task_drag_handle" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:contentDescription="@string/task_drag_description" android:padding="@dimen/space_12" android:src="@drawable/ic_drag_handle" android:visibility="gone" app:tint="@color/text_secondary" />
        <View android:id="@+id/task_color_rail" android:layout_width="@dimen/layout_zero" android:layout_height="@dimen/layout_zero" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
