<?xml version="1.0" encoding="utf-8"?>
<!-- A single onboarding step with a visual, title and short practical instruction. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_24">
    <ImageView android:id="@+id/onboarding_image" android:layout_width="@dimen/progress_ring_size"
        android:layout_height="@dimen/progress_ring_size" android:contentDescription="@string/app_logo" />
    <TextView android:id="@+id/onboarding_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32"
        android:gravity="center" android:textAppearance="@style/TextAppearance.PetCare.Display" />
    <TextView android:id="@+id/onboarding_description" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16"
        android:gravity="center" android:textAppearance="@style/TextAppearance.PetCare.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
