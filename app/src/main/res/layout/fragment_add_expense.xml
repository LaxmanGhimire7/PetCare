<?xml version="1.0" encoding="utf-8"?>
<!-- Adds or edits an expense for one pet with date, category, amount, and note. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_24">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancel_button" style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" />
        <TextView android:id="@+id/form_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/add_expense" android:textAppearance="@style/TextAppearance.PetCare.Display" android:textColor="@color/on_surface" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/pet_layout" style="@style/Widget.PetCare.TextInput.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:hint="@string/select_pet" android:labelFor="@id/pet_input">
        <AutoCompleteTextView android:id="@+id/pet_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/expense_category" android:labelFor="@id/category_input">
        <AutoCompleteTextView android:id="@+id/category_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/amount_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/expense_amount">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/expense_date" app:endIconDrawable="@drawable/ic_calendar" app:endIconMode="custom">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/date_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/expense_note">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/note_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/save_button" style="@style/Widget.PetCare.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="@string/save_expense" />
    </LinearLayout>
</ScrollView>
