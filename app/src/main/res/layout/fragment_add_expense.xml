<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane expense sheet: amount first, then category, pet, date and note. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_sheet"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_32">

        <ImageView
            android:layout_width="@dimen/space_40"
            android:layout_height="@dimen/space_24"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_drag_handle"
            app:tint="@color/hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/form_title"
                android:layout_width="@dimen/layout_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_expense"
                android:textAppearance="@style/TextAppearance.PetCare.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/space_40"
                android:layout_height="@dimen/space_40"
                android:contentDescription="@string/cancel"
                app:backgroundTint="@color/surface_raised"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/text_primary" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/amount_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:hint="@string/expense_amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PetCare.Amount" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/expense_category"
            android:textAppearance="@style/TextAppearance.PetCare.Section" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/category_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:chipSpacingVertical="@dimen/space_8"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/expense_for_pet"
            android:textAppearance="@style/TextAppearance.PetCare.Section" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/pet_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:chipSpacingVertical="@dimen/space_8"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/selection_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/error_pet_selection_required"
            android:textAppearance="@style/TextAppearance.PetCare.Supporting"
            android:textColor="@color/error"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/expense_date"
            android:textAppearance="@style/TextAppearance.PetCare.Section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/date_button"
            style="@style/Widget.PetCare.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:hint="@string/expense_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/note_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            style="@style/Widget.PetCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/save_expense" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
