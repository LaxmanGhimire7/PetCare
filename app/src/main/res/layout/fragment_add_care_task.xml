<?xml version="1.0" encoding="utf-8"?>
<!-- Adds or edits a care task with pet, schedule, repeat, supplies, and place fields. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/layout_36_dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.PetCare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/care_task_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/add_care_task_title"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/care_task_form_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/add_care_task_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_28_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/layout_18_dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/space_48"
                    android:layout_height="@dimen/space_48"
                    app:cardBackgroundColor="@color/secondary_container"
                    app:cardCornerRadius="@dimen/space_16"
                    app:cardElevation="@dimen/layout_zero">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/on_secondary_container" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="@dimen/layout_zero"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_14_dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/care_plan_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/layout_3_dp"
                        android:text="@string/care_plan_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/care_task_title_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:hint="@string/care_task_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/care_task_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/category_layout"
                style="@style/Widget.PetCare.TextInput.Dropdown"
                android:layout_width="@dimen/layout_zero"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/layout_6_dp"
                android:layout_weight="1"
                android:hint="@string/task_category"
                android:labelFor="@id/category_input"
                app:boxBackgroundColor="@color/surface_container_low">

                <AutoCompleteTextView
                    android:id="@+id/category_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/frequency_layout"
                style="@style/Widget.PetCare.TextInput.Dropdown"
                android:layout_width="@dimen/layout_zero"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_6_dp"
                android:layout_weight="1"
                android:hint="@string/task_frequency"
                android:labelFor="@id/frequency_input"
                app:boxBackgroundColor="@color/surface_container_low">

                <AutoCompleteTextView
                    android:id="@+id/frequency_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pet_layout"
            style="@style/Widget.PetCare.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/select_pet"
            android:labelFor="@id/pet_input"
            app:boxBackgroundColor="@color/surface_container_low"
            app:boxCornerRadiusBottomEnd="@dimen/space_16"
            app:boxCornerRadiusBottomStart="@dimen/space_16"
            app:boxCornerRadiusTopEnd="@dimen/space_16"
            app:boxCornerRadiusTopStart="@dimen/space_16">

            <AutoCompleteTextView
                android:id="@+id/pet_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/task_place_layout"
            style="@style/Widget.PetCare.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/task_place"
            android:labelFor="@id/task_place_input">
            <AutoCompleteTextView
                android:id="@+id/task_place_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/due_date_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/due_date"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/due_date_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reminder_time_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/reminder_time"
            app:endIconDrawable="@drawable/ic_alarm"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reminder_time_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/required_supplies_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/required_supplies">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/required_supplies_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/care_notes_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/task_notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/care_notes_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_care_task_button"
            style="@style/Widget.PetCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/save_care_task"
            app:icon="@drawable/ic_check"
            app:iconPadding="@dimen/space_8"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</ScrollView>
