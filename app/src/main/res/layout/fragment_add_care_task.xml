<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane new-task form with visual pet/category choices and grouped scheduling fields. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true">

    <LinearLayout android:id="@+id/task_top_bar" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_12" android:paddingTop="@dimen/space_8" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancel_button" style="@style/Widget.Material3.Button.IconButton" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:contentDescription="@string/cancel" app:icon="@drawable/pc_ic_close" app:iconTint="@color/pc_text_primary" />
        <TextView android:id="@+id/care_task_form_title" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:gravity="start" android:text="@string/new_task" android:textAppearance="@style/TextAppearance.PC.Headline" />
    </LinearLayout>

    <ScrollView android:id="@+id/task_form_scroll" android:layout_width="@dimen/layout_zero" android:layout_height="@dimen/layout_zero" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="@dimen/space_24" app:layout_constraintBottom_toTopOf="@id/save_care_task_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/task_top_bar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/space_20">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/care_task_title_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/what_needs_doing" app:boxBackgroundColor="@android:color/transparent">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/care_task_title_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textCapSentences" android:textAppearance="@style/TextAppearance.PetCare.Headline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/task_for" android:textAppearance="@style/TextAppearance.PetCare.Section" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:scrollbars="none">
                <LinearLayout android:id="@+id/pet_avatar_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView android:id="@+id/pet_error_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Supporting" android:textColor="@color/error" android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/task_category" android:textAppearance="@style/TextAppearance.PetCare.Section" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup android:id="@+id/category_chip_group"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/task_when" android:textAppearance="@style/TextAppearance.PetCare.Section" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="@dimen/radius_icon_well" app:cardElevation="@dimen/layout_zero">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_12">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/due_date_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/due_date" app:endIconDrawable="@drawable/ic_calendar" app:endIconMode="custom">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/due_date_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/reminder_time_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/reminder_time" app:endIconDrawable="@drawable/ic_alarm" app:endIconMode="custom">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/reminder_time_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/frequency_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" app:checkedButton="@id/repeat_once" app:selectionRequired="true" app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/repeat_once" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/repeat_once" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/repeat_daily" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/repeat_daily" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/repeat_weekly" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/repeat_weekly" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/repeat_monthly" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/repeat_monthly" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/task_details" android:textAppearance="@style/TextAppearance.PetCare.Section" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/task_place_layout" style="@style/Widget.PetCare.TextInput.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/task_place" android:labelFor="@id/task_place_input">
                <AutoCompleteTextView android:id="@+id/task_place_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/required_supplies_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/required_supplies">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/required_supplies_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/care_notes_layout" style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/task_notes">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/care_notes_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/save_care_task_button" style="@style/Widget.PetCare.Button.Primary" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_20" android:layout_marginBottom="@dimen/space_12" android:text="@string/save_care_task" app:icon="@drawable/ic_check" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
