<?xml version="1.0" encoding="utf-8"?>
<!-- Category name, coloured bar, and amount in the spending breakdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <View android:id="@+id/category_color" android:layout_width="@dimen/space_12"
            android:layout_height="@dimen/space_12" android:background="@drawable/bg_now_dot" />
        <TextView android:id="@+id/category_name" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1" android:textAppearance="@style/TextAppearance.PetCare.RowTitle"
            android:textColor="@color/text_primary" />
        <TextView android:id="@+id/category_amount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Figure"
            android:textColor="@color/text_primary" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/category_progress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
        android:indeterminate="false" android:max="1000" android:progress="0"
        app:trackColor="@color/track" app:trackThickness="8dp" />
    <TextView android:id="@+id/category_share" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
        android:gravity="end" android:textAppearance="@style/TextAppearance.PetCare.Label"
        android:textColor="@color/text_secondary" />
</LinearLayout>
