<?xml version="1.0" encoding="utf-8"?>
<!-- Primary Settings destination for care preferences and account actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_24" android:paddingBottom="@dimen/space_32">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/nav_settings"
        android:textAppearance="@style/TextAppearance.PetCare.Headline" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/settings_screen_subtitle"
        android:textAppearance="@style/TextAppearance.PetCare.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView android:id="@+id/account_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:textAppearance="@style/TextAppearance.PetCare.Title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reminder_settings_button"
        style="@style/Widget.PetCare.Button.Tonal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/reminder_settings_title"
        app:icon="@drawable/ic_alarm" />

    <com.google.android.material.button.MaterialButton android:id="@+id/theme_button"
        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/settings_theme" />
    <com.google.android.material.button.MaterialButton android:id="@+id/search_button"
        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/search_title" />

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/notifications_switch"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" android:minHeight="@dimen/space_48"
        android:text="@string/settings_notifications" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/biometric_switch"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" android:minHeight="@dimen/space_48"
        android:text="@string/settings_biometric" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/replay_gestures_button"
        style="@style/Widget.PetCare.Button.Tonal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/gesture_coach_replay" />

    <com.google.android.material.button.MaterialButton android:id="@+id/backup_button"
        style="@style/Widget.PetCare.Button.Tonal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/backup_data" />
    <com.google.android.material.button.MaterialButton android:id="@+id/restore_button"
        style="@style/Widget.PetCare.Button.Outlined" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/restore_data" />
    <com.google.android.material.button.MaterialButton android:id="@+id/clear_data_button"
        style="@style/Widget.PetCare.Button.Outlined" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/clear_care_data" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sign_out_button"
        style="@style/Widget.PetCare.Button.Outlined"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/sign_out" />

    <TextView android:id="@+id/about_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24"
        android:textAppearance="@style/TextAppearance.PetCare.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />
    <TextView android:id="@+id/version_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.PetCare.Label"
        android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
