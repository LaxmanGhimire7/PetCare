<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane settings: profile header and grouped preferences, security, data, and help rows. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/fab_clearance">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_settings" android:textAppearance="@style/TextAppearance.PetCare.Display" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/space_16">
                <TextView android:id="@+id/profile_initials" android:layout_width="@dimen/space_48"
                    android:layout_height="@dimen/space_48" android:background="@drawable/bg_profile_avatar"
                    android:gravity="center" android:textAppearance="@style/TextAppearance.PetCare.Section"
                    android:textColor="@color/on_primary_container" />
                <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/account_text" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Section" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2" android:text="@string/settings_account_type"
                        android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsSectionTitle" android:text="@string/settings_appearance" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="@dimen/space_4">
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/settings_theme" app:icon="@drawable/ic_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsSectionTitle" android:text="@string/settings_reminders" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_12">
                <com.google.android.material.button.MaterialButton android:id="@+id/reminder_settings_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/reminder_settings_title" app:icon="@drawable/ic_alarm" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/notifications_switch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target" android:text="@string/settings_notifications"
                    android:textAppearance="@style/TextAppearance.PetCare.RowTitle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsSectionTitle" android:text="@string/settings_security" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="@dimen/space_4">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/biometric_switch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target" android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_8" android:text="@string/settings_biometric"
                    android:textAppearance="@style/TextAppearance.PetCare.RowTitle" />
                <com.google.android.material.button.MaterialButton android:id="@+id/change_password_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/settings_change_password"
                    app:icon="@drawable/pc_ic_key" />
                <com.google.android.material.button.MaterialButton android:id="@+id/account_recovery_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/settings_account_recovery"
                    app:icon="@drawable/pc_ic_shield" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsSectionTitle" android:text="@string/settings_your_data" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="@dimen/space_4">
                <com.google.android.material.button.MaterialButton android:id="@+id/backup_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/backup_data" app:icon="@drawable/ic_export" />
                <com.google.android.material.button.MaterialButton android:id="@+id/restore_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/restore_data" app:icon="@drawable/ic_import" />
                <com.google.android.material.button.MaterialButton android:id="@+id/load_demo_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/load_demo_data"
                    android:visibility="gone" app:icon="@drawable/ic_refresh" />
                <com.google.android.material.button.MaterialButton android:id="@+id/clear_data_button"
                    style="@style/Widget.PetCare.SettingsRow.Destructive" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/clear_care_data" app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SettingsSectionTitle" android:text="@string/settings_help" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="@dimen/space_4">
                <com.google.android.material.button.MaterialButton android:id="@+id/search_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/search_title" app:icon="@drawable/ic_pets" />
                <com.google.android.material.button.MaterialButton android:id="@+id/replay_gestures_button"
                    style="@style/Widget.PetCare.SettingsRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/gesture_coach_replay" app:icon="@drawable/ic_refresh" />
                <TextView android:id="@+id/about_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_target"
                    android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12"
                    android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:id="@+id/version_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16"
                    android:paddingBottom="@dimen/space_12" android:textAppearance="@style/TextAppearance.PetCare.Label"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/sign_out_button"
            style="@style/Widget.PetCare.SettingsRow.Destructive" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_28"
            android:text="@string/sign_out" app:icon="@drawable/ic_lock" />
    </LinearLayout>
</ScrollView>
