<?xml version="1.0" encoding="utf-8"?>
<!-- This month's spending: total, a bar split by pet colour, and a per-pet legend. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pc_bg_surface_18"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/pcMonthFilled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pcMonthTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.PC.Amount"
                tools:text="£142.50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/pc_spent_on_care"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />
        </LinearLayout>

        <com.example.petcare.design.SegmentedBarView
            android:id="@+id/pcMonthBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp" />

        <!-- One entry per pet is added by PetsScreenBinder. -->
        <LinearLayout
            android:id="@+id/pcMonthLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcMonthEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pc_no_spending"
            android:textAppearance="@style/TextAppearance.PC.Body"
            android:textColor="@color/pc_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcMonthAddExpense"
            style="@style/Widget.PC.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pc_add_expense" />
    </LinearLayout>
</LinearLayout>
