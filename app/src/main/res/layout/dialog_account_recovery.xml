<?xml version="1.0" encoding="utf-8"?>
<!-- Collects the recovery question and answer for a local account. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/recovery_question_layout"
        style="@style/Widget.PC.TextInput.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pc_security_question">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/recovery_question_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/recovery_answer_layout"
        style="@style/Widget.PC.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/pc_security_answer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/recovery_answer_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
