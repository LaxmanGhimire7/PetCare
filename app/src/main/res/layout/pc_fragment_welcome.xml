<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome: the app's entry point, with Log in and Create account.
    The Next-up card is a live, ticking preview of the app's signature element.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcWelcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/pc_bg_brand"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/pc_ic_paw"
                app:tint="@color/pc_on_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/pc_brand"
                android:textAppearance="@style/TextAppearance.PC.Headline" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pc_welcome_title"
            android:textAppearance="@style/TextAppearance.PC.Hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pc_welcome_body"
            android:textAppearance="@style/TextAppearance.PC.Body"
            android:textColor="@color/pc_text_secondary" />

        <!-- Live preview of the Next-up card. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/pc_bg_surface_24"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_next_up"
                    android:textAppearance="@style/TextAppearance.PC.LabelStrong"
                    android:textColor="@color/pc_text_secondary" />

                <TextView
                    android:id="@+id/pcWelcomePet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pc_bg_pill"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="@string/pc_welcome_card_pet"
                    android:textAppearance="@style/TextAppearance.PC.MetaStrong" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="@string/pc_welcome_card_title"
                android:textAppearance="@style/TextAppearance.PC.Headline" />

            <TextView
                android:id="@+id/pcWelcomeCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.PC.Countdown"
                tools:text="00:57:48" />

            <com.example.petcare.design.SegmentedBarView
                android:id="@+id/pcWelcomeBar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcWelcomeCreate"
            style="@style/Widget.PC.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/pc_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcWelcomeLogIn"
            style="@style/Widget.PC.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/pc_log_in" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
