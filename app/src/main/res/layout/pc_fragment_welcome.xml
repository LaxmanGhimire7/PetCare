<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome: the app's front page (the brief's "home screen with login or signup").
    Calm and simple: brand, a cluster of the app's own pet rings, one headline, and the
    three ways in. No live data, no timer.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pcWelcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/pc_bg_brand"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/pc_ic_paw"
                app:tint="@color/pc_on_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/pc_brand"
                android:textAppearance="@style/TextAppearance.PC.Headline" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- Hero: three pet rings, sweeping in once. Decorative. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:importantForAccessibility="noHideDescendants">

            <FrameLayout
                android:id="@+id/pcWelcomeRingDog"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginEnd="76dp">

                <com.example.petcare.design.PetRingView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pc_bg_oval"
                    android:importantForAccessibility="no"
                    android:padding="26dp"
                    android:src="@drawable/pc_ic_dog" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pcWelcomeRingCat"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="104dp"
                android:layout_marginBottom="4dp">

                <com.example.petcare.design.PetRingView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pc_bg_oval"
                    android:importantForAccessibility="no"
                    android:padding="19dp"
                    android:src="@drawable/pc_ic_cat" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pcWelcomeRingPaw"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginEnd="176dp">

                <com.example.petcare.design.PetRingView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pc_bg_oval"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/pc_ic_paw" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:includeFontPadding="false"
            android:text="@string/pc_welcome_headline"
            android:textAppearance="@style/TextAppearance.PC.Hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pc_welcome_sub"
            android:textAppearance="@style/TextAppearance.PC.Body"
            android:textColor="@color/pc_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcWelcomeCreate"
            style="@style/Widget.PC.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/pc_create_account" />

        <!-- Shown once Google sign-in is wired (GoogleAuthFlow.attach). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcWelcomeGoogle"
            style="@style/Widget.PC.Button.Google"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/pc_continue_google"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_have_account"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pcWelcomeLogIn"
                style="@style/Widget.PC.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_log_in" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
