<?xml version="1.0" encoding="utf-8"?>
<!-- Notification centre: reminders, overdue alerts, health dates and shared checklists. Swipe left to remove. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pcInboxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/pcInboxBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/pc_bg_icon_button"
            android:contentDescription="@string/pc_a11y_back"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pc_ic_back"
            app:tint="@color/pc_text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcInboxMarkAll"
            style="@style/Widget.PC.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pc_mark_all_read" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:text="@string/pc_notifications"
        android:textAppearance="@style/TextAppearance.PC.Display" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pcInboxList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/pcInboxEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="64dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/pc_bg_icon_button"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/pc_ic_bell"
                app:tint="@color/pc_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pc_inbox_empty_title"
                android:textAppearance="@style/TextAppearance.PC.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/pc_inbox_empty_body"
                android:textAppearance="@style/TextAppearance.PC.Supporting" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
