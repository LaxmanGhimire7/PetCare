<?xml version="1.0" encoding="utf-8"?>
<!-- Today pet ring item from redesign D1: identity, selection, and daily completion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/pet_filter_width" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="@dimen/space_8">
    <com.example.petcare.ui.PetAvatarView android:id="@+id/filter_avatar_view"
        android:layout_width="@dimen/pet_filter_avatar" android:layout_height="@dimen/pet_filter_avatar" />
    <TextView android:id="@+id/filter_name_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
        android:ellipsize="end" android:gravity="center" android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PetCare.Label" />
    <TextView android:id="@+id/filter_progress_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:textAppearance="@style/TextAppearance.PetCare.Numeric" />
</LinearLayout>
