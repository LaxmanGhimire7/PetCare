<?xml version="1.0" encoding="utf-8"?>
<!-- Circular pet filter with a fixed identity-colour ring and a short label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/pet_filter_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="@dimen/space_8">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/filter_avatar_card"
        android:layout_width="@dimen/pet_filter_avatar"
        android:layout_height="@dimen/pet_filter_avatar"
        app:cardCornerRadius="@dimen/radius_chip"
        app:cardElevation="@dimen/layout_zero"
        app:strokeWidth="@dimen/space_4">
        <ImageView
            android:id="@+id/filter_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_12"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pets"
            android:contentDescription="@string/pet_photo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/filter_name_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.PetCare.Label" />
</LinearLayout>
