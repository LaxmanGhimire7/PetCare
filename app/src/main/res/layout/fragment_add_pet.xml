<?xml version="1.0" encoding="utf-8"?>
<!-- Creates or edits a pet profile, identity colour, photos, and care notes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/layout_36_dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.PetCare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/pet_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/add_pet_title"
            android:textAppearance="@style/TextAppearance.PetCare.Display"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/pet_form_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/add_pet_subtitle"
            android:textAppearance="@style/TextAppearance.PetCare.Supporting"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_28_dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/layout_18_dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/pet_photo_picker_size"
                    android:layout_height="@dimen/pet_photo_picker_size"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="@dimen/radius_pill"
                    app:cardElevation="@dimen/layout_zero">

                    <ImageView
                        android:id="@+id/pet_photo_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/pet_photo"
                        android:padding="@dimen/layout_22_dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pets" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="@dimen/layout_zero"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/photo_count_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_photo_title"
                        android:textAppearance="@style/TextAppearance.PetCare.Section"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/profile_photo_subtitle"
                        android:textAppearance="@style/TextAppearance.PetCare.Supporting"
                        android:textColor="@color/on_surface_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/select_photo_button"
                        style="@style/Widget.PetCare.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/layout_6_dp"
                        android:text="@string/add_photos"
                        app:icon="@drawable/ic_photo"
                        app:iconPadding="@dimen/layout_6_dp"
                        app:iconSize="@dimen/layout_18_dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/pet_tag_color"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/pet_color_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pet_name_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_22_dp"
            android:hint="@string/pet_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pet_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pet_species_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/pet_species">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pet_species_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PetCare.TextInput"
                android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/layout_6_dp" android:layout_weight="1" android:hint="@string/pet_breed">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/pet_breed_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PetCare.TextInput"
                android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_6_dp" android:layout_weight="1" android:hint="@string/pet_age">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/pet_age_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/pet_weight">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/pet_weight_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/dietary_preferences">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/dietary_preferences_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/vaccination_history">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/vaccination_history_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/allergies">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/allergies_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/favorite_toys">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/favorite_toys_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/medical_records">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/medical_records_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/grooming_routine">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/grooming_routine_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/health_notes_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_14_dp"
            android:hint="@string/health_notes"
            app:helperText="@string/health_notes_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/health_notes_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_pet_button"
            style="@style/Widget.PetCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/save_pet"
            app:icon="@drawable/ic_check"
            app:iconPadding="@dimen/space_8"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</ScrollView>
