<?xml version="1.0" encoding="utf-8"?>
<!-- Today dashboard compact header and care list; implements redesign fixes B4, B5, B8 and B11. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/today_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas"
        app:elevation="@dimen/layout_zero"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/today_scroll">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/today_appbar_expanded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20">
            <LinearLayout
                android:layout_width="@dimen/layout_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/today_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/greeting_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.PetCare.Display"
                    app:autoSizeMaxTextSize="@dimen/greeting_max_text"
                    app:autoSizeMinTextSize="@dimen/greeting_min_text"
                    app:autoSizeStepGranularity="@dimen/greeting_text_step"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
            <TextView
                android:id="@+id/profile_avatar_text"
                android:layout_width="@dimen/space_40"
                android:layout_height="@dimen/space_40"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_profile_avatar"
                android:contentDescription="@string/open_settings"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PetCare.Label" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_2"
            android:background="@color/hairline" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/today_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/today_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_clearance">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/layout_zero">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_16">
                    <com.example.petcare.ui.home.ProgressRingView
                        android:id="@+id/progress_ring"
                        android:layout_width="@dimen/progress_ring_size"
                        android:layout_height="@dimen/progress_ring_size" />
                    <LinearLayout
                        android:layout_width="@dimen/layout_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/progress_count_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PetCare.Title" />
                        <TextView
                            android:id="@+id/next_task_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.PetCare.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pet_filter_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/upcoming_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:textAppearance="@style/TextAppearance.PetCare.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reorder_mode_button"
                style="@style/Widget.PetCare.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/task_options" app:icon="@drawable/ic_more" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_task_inline"
                style="@style/Widget.PetCare.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/add_task"
                android:visibility="gone" />

            <com.example.petcare.ui.home.ShimmerSkeletonView
                android:id="@+id/loading_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/skeleton_block_height" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/today_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_card">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:padding="@dimen/space_24">
                    <TextView android:id="@+id/today_empty_text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.Body" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/today_empty_action"
                        style="@style/Widget.PetCare.Button.Primary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/completed_header"
                style="@style/Widget.PetCare.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="start"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/completed_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32" android:text="@string/quick_actions"
                android:textAppearance="@style/TextAppearance.PetCare.Title" />

            <LinearLayout
                android:id="@+id/quick_actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/generate_routine_button" style="@style/Widget.PetCare.QuickActionButton" android:layout_width="@dimen/quick_action_size" android:layout_height="@dimen/quick_action_size" android:contentDescription="@string/new_routine" app:icon="@drawable/ic_routine" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" android:maxLines="2" android:text="@string/new_routine" android:textAppearance="@style/TextAppearance.PetCare.Label" />
                </LinearLayout>
                <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/share_checklist_button" style="@style/Widget.PetCare.QuickActionButton" android:layout_width="@dimen/quick_action_size" android:layout_height="@dimen/quick_action_size" android:contentDescription="@string/share_list" app:icon="@drawable/ic_share" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" android:maxLines="2" android:text="@string/share_list" android:textAppearance="@style/TextAppearance.PetCare.Label" />
                </LinearLayout>
                <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/import_appointment_button" style="@style/Widget.PetCare.QuickActionButton" android:layout_width="@dimen/quick_action_size" android:layout_height="@dimen/quick_action_size" android:contentDescription="@string/import_plan" app:icon="@drawable/ic_import" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" android:maxLines="2" android:text="@string/import_plan" android:textAppearance="@style/TextAppearance.PetCare.Label" />
                </LinearLayout>
                <LinearLayout android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/export_plan_button" style="@style/Widget.PetCare.QuickActionButton" android:layout_width="@dimen/quick_action_size" android:layout_height="@dimen/quick_action_size" android:contentDescription="@string/export_plan" app:icon="@drawable/ic_export" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" android:maxLines="2" android:text="@string/export_plan" android:textAppearance="@style/TextAppearance.PetCare.Label" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_checklist_button"
                style="@style/Widget.PetCare.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/reset_today_checklist"
                android:visibility="gone"
                app:icon="@drawable/ic_refresh" />
            <TextView
                android:id="@+id/import_sources_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/import_sources_hint"
                android:textAppearance="@style/TextAppearance.PetCare.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_task_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:text="@string/new_task"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
