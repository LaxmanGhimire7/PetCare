<?xml version="1.0" encoding="utf-8"?>
<!-- Today dashboard: collapsible greeting, progress, pet filter and care lists. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/today_appbar_expanded"
            android:minHeight="@dimen/today_appbar_collapsed"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="?attr/colorSurface"
            app:expandedTitleMarginStart="@dimen/space_20"
            app:expandedTitleMarginBottom="@dimen/space_24"
            app:expandedTitleTextAppearance="@style/TextAppearance.PetCare.Display"
            app:collapsedTitleTextAppearance="@style/TextAppearance.PetCare.Title">
            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="@dimen/today_appbar_collapsed"
                app:layout_collapseMode="pin">
                <ImageView
                    android:layout_width="@dimen/space_32"
                    android:layout_height="@dimen/space_32"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_20"
                    android:src="@drawable/ic_pets"
                    android:contentDescription="@string/app_logo" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/today_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_32"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_16">
                    <com.example.petcare.ui.home.ProgressRingView
                        android:id="@+id/progress_ring"
                        android:layout_width="@dimen/progress_ring_size"
                        android:layout_height="@dimen/progress_ring_size" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/progress_count_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PetCare.Title" />
                        <TextView
                            android:id="@+id/next_task_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.PetCare.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pet_filter_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/upcoming_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:textAppearance="@style/TextAppearance.PetCare.Headline" />

            <com.example.petcare.ui.home.ShimmerSkeletonView
                android:id="@+id/loading_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/skeleton_block_height" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/today_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_card">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:padding="@dimen/space_24">
                    <TextView android:id="@+id/today_empty_text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetCare.Body" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/today_empty_action"
                        style="@style/Widget.PetCare.Button.Primary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/completed_header"
                style="@style/Widget.PetCare.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="start"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/completed_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/today_care_tools"
                android:textAppearance="@style/TextAppearance.PetCare.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generate_routine_button"
                style="@style/Widget.PetCare.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/generate_routine"
                app:icon="@drawable/ic_routine" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/share_checklist_button"
                style="@style/Widget.PetCare.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/share_checklist"
                  app:icon="@drawable/ic_share" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/export_plan_button"
                  style="@style/Widget.PetCare.Button.Tonal"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_8"
                  android:text="@string/export_care_plan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_appointment_button"
                style="@style/Widget.PetCare.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/import_appointment"
                app:icon="@drawable/ic_import" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_task_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:text="@string/add_task"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
