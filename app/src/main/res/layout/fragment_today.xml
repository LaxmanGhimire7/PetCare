<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane Today: countdown hero, pet progress, week selection and a chronological timeline. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/today_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas"
        android:fitsSystemWindows="true"
        app:elevation="@dimen/layout_zero"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/today_scroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/today_appbar_expanded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_8">

            <LinearLayout
                android:layout_width="@dimen/layout_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/today_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/greeting_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PetCare.Display"
                    app:autoSizeMaxTextSize="@dimen/layout_34_sp"
                    app:autoSizeMinTextSize="@dimen/greeting_min_text"
                    app:autoSizeStepGranularity="@dimen/greeting_text_step"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_avatar_text"
                android:layout_width="@dimen/layout_36_dp"
                android:layout_height="@dimen/layout_36_dp"
                android:background="@drawable/bg_profile_avatar"
                android:contentDescription="@string/open_settings"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PetCare.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reorder_mode_button"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/space_40"
                android:layout_height="@dimen/space_40"
                android:layout_marginStart="@dimen/space_4"
                android:contentDescription="@string/task_options"
                app:backgroundTint="@color/surface_raised"
                app:icon="@drawable/ic_more"
                app:iconTint="@color/text_primary" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="@dimen/layout_1_dp" android:background="@color/hairline" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/today_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/today_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/fab_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16">

                <LinearLayout
                    android:id="@+id/today_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/next_up_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/radius_header"
                        app:cardElevation="@dimen/layout_zero">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_16">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/next_up" android:textAppearance="@style/TextAppearance.PetCare.Label" android:textColor="@color/text_secondary" />
                                <TextView android:id="@+id/next_overdue_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_overdue_pill" android:paddingHorizontal="@dimen/space_8" android:paddingVertical="@dimen/space_4" android:textAppearance="@style/TextAppearance.PetCare.Label" android:textColor="@color/on_error_container" android:visibility="gone" />
                                <TextView android:id="@+id/next_pet_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:paddingHorizontal="@dimen/space_8" android:paddingVertical="@dimen/space_4" android:textAppearance="@style/TextAppearance.PetCare.Label" />
                            </LinearLayout>
                            <TextView android:id="@+id/next_task_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textAppearance="@style/TextAppearance.PetCare.Headline" />
                            <TextView android:id="@+id/countdown_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/countdown_no_task" android:maxLines="1" android:textAppearance="@style/TextAppearance.PetCare.Countdown" />
                            <TextView android:id="@+id/countdown_until_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                            <com.example.petcare.ui.home.SegmentedProgressView android:id="@+id/progress_ring" android:layout_width="match_parent" android:layout_height="@dimen/space_8" android:layout_marginTop="@dimen/space_12" />
                            <TextView android:id="@+id/progress_count_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                            <LinearLayout android:id="@+id/next_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton android:id="@+id/next_mark_done_button" style="@style/Widget.PetCare.Button.Primary" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mark_done" app:icon="@drawable/ic_check" />
                                <com.google.android.material.button.MaterialButton android:id="@+id/next_snooze_button" style="@style/Widget.PetCare.Button.Tonal" android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:text="@string/snooze" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pet_filter_recycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:clipToPadding="false" android:orientation="horizontal" />

                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:scrollbars="none">
                        <LinearLayout android:id="@+id/quick_actions_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.chip.Chip android:id="@+id/share_checklist_button" android:layout_width="wrap_content" android:layout_height="@dimen/layout_36_dp" android:text="@string/share_checklist" app:chipIcon="@drawable/ic_share" app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip android:id="@+id/generate_routine_button" android:layout_width="wrap_content" android:layout_height="@dimen/layout_36_dp" android:layout_marginStart="@dimen/space_8" android:text="@string/new_routine" app:chipIcon="@drawable/ic_routine" app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip android:id="@+id/import_appointment_button" android:layout_width="wrap_content" android:layout_height="@dimen/layout_36_dp" android:layout_marginStart="@dimen/space_8" android:text="@string/import_plan" app:chipIcon="@drawable/ic_import" app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip android:id="@+id/export_plan_button" android:layout_width="wrap_content" android:layout_height="@dimen/layout_36_dp" android:layout_marginStart="@dimen/space_8" android:text="@string/export_plan" app:chipIcon="@drawable/ic_export" app:chipIconVisible="true" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/week_recycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:clipToPadding="false" />

                    <TextView android:id="@+id/upcoming_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/timeline" android:textAppearance="@style/TextAppearance.PetCare.Section" />

                    <com.example.petcare.ui.home.ShimmerSkeletonView android:id="@+id/loading_skeleton" android:layout_width="match_parent" android:layout_height="@dimen/skeleton_block_height" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/task_recycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
                    <LinearLayout android:id="@+id/now_after_timeline" android:layout_width="match_parent" android:layout_height="@dimen/space_40" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:id="@+id/now_after_time" android:layout_width="@dimen/timeline_time_width" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PetCare.Figure" android:textColor="@color/primary_text" />
                        <View android:layout_width="@dimen/space_8" android:layout_height="@dimen/space_8" android:layout_marginHorizontal="@dimen/space_8" android:background="@drawable/bg_now_dot" />
                        <View android:layout_width="@dimen/layout_zero" android:layout_height="@dimen/timeline_connector_width" android:layout_weight="1" android:background="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:text="@string/now" android:textAppearance="@style/TextAppearance.PetCare.Label" android:textColor="@color/primary_text" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView android:id="@+id/today_empty_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="@dimen/radius_header" app:cardElevation="@dimen/layout_zero">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_32">
                        <ImageView android:layout_width="@dimen/progress_ring_size" android:layout_height="@dimen/progress_ring_size" android:contentDescription="@null" android:src="@drawable/ic_pets" app:tint="@color/primary" />
                        <TextView android:id="@+id/today_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/TextAppearance.PetCare.Section" />
                        <TextView android:id="@+id/today_empty_supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:text="@string/today_empty_pets_supporting" android:textAppearance="@style/TextAppearance.PetCare.Supporting" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/today_empty_action" style="@style/Widget.PetCare.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton android:id="@+id/add_task_inline" style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_task" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_task_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="@string/new_task"
        app:backgroundTint="@color/primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Fab"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
