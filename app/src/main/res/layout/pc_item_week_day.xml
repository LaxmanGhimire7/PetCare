<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the week strip. Selected state is applied by WeekStripBinder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/pcDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PC.Meta"
        tools:text="Tue" />

    <TextView
        android:id="@+id/pcDayDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.PC.FigureLarge"
        tools:text="22" />

    <!-- How much of the day got done. Hidden on days with no tasks. -->
    <com.example.petcare.design.SegmentedBarView
        android:id="@+id/pcDayBar"
        android:layout_width="18dp"
        android:layout_height="3dp"
        android:layout_marginTop="4dp" />
</LinearLayout>
