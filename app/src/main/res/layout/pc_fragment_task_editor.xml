<?xml version="1.0" encoding="utf-8"?>
<!--
    New task / Edit task. Bound by TaskEditorBinder: the fragment only supplies pets,
    categories and places, and saves the TaskDraft it gets back.
    The Save button stays pinned above the keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/pcEditorClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/pc_bg_icon_button"
            android:contentDescription="@string/pc_a11y_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pc_ic_close"
            app:tint="@color/pc_text_primary" />

        <TextView
            android:id="@+id/pcEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PC.Headline"
            tools:text="New task" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/pcEditorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/pcEditorContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- The task name, written big like a headline. -->
            <EditText
                android:id="@+id/pcEditorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@null"
                android:hint="@string/pc_task_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.PC.Headline"
                android:textColorHint="@color/pc_text_secondary" />

            <View
                android:id="@+id/pcEditorNameLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pc_hairline" />

            <TextView
                android:id="@+id/pcEditorNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                android:textColor="@color/pc_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pc_for"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <!-- One ring per pet, added by TaskEditorBinder. -->
                <LinearLayout
                    android:id="@+id/pcEditorPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/pcEditorPetError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                android:textColor="@color/pc_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/pc_category"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/pcEditorCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/pcEditorCategoryError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                android:textColor="@color/pc_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/pc_when"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/pc_bg_surface_18"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/pcEditorDateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pc_ic_calendar"
                        app:tint="@color/pc_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/pc_date"
                        android:textAppearance="@style/TextAppearance.PC.Body" />

                    <TextView
                        android:id="@+id/pcEditorDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PC.RowTitle" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pc_ic_chevron_right"
                        app:tint="@color/pc_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="46dp"
                    android:background="@color/pc_hairline" />

                <LinearLayout
                    android:id="@+id/pcEditorTimeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pc_ic_clock"
                        app:tint="@color/pc_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/pc_time"
                        android:textAppearance="@style/TextAppearance.PC.Body" />

                    <TextView
                        android:id="@+id/pcEditorTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PC.RowTitle" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pc_ic_chevron_right"
                        app:tint="@color/pc_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/pcEditorDateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                android:textColor="@color/pc_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pc_repeat"
                android:textAppearance="@style/TextAppearance.PC.LabelStrong"
                android:textColor="@color/pc_text_secondary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pcEditorRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:checkedButton="@+id/pcRepeatOnce"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pcRepeatOnce"
                    style="@style/Widget.PC.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/pc_repeat_once" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pcRepeatDaily"
                    style="@style/Widget.PC.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/pc_repeat_daily" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pcRepeatWeekly"
                    style="@style/Widget.PC.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/pc_repeat_weekly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pcRepeatMonthly"
                    style="@style/Widget.PC.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/pc_repeat_monthly" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/pc_details"
                android:textAppearance="@style/TextAppearance.PC.Section" />

            <!-- Hint on the layout only: this is what fixes the overlapping "Saved place" text. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcEditorPlaceLayout"
                style="@style/Widget.PC.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/pc_saved_place"
                app:startIconDrawable="@drawable/pc_ic_nav_places">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/pcEditorPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcEditorSuppliesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_supplies_hint"
                app:startIconDrawable="@drawable/pc_ic_supplies">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcEditorSupplies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pcEditorNotesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pc_notes_hint"
                app:startIconDrawable="@drawable/pc_ic_notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pcEditorNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned Save bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pc_bg_nav"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcEditorSave"
            style="@style/Widget.PC.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/pc_save_task"
            app:icon="@drawable/pc_ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
