<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen summary of today's next three tasks; each row opens task detail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/surface_container" android:padding="@dimen/space_16">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/widget_title"
        android:textAppearance="@style/TextAppearance.PetCare.Title"
        android:textColor="@color/on_surface" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
        android:text="@string/widget_empty" android:textColor="@color/on_surface_variant" />
    <TextView android:id="@+id/widget_row_one" android:layout_width="match_parent"
        android:layout_height="@dimen/space_48" android:gravity="center_vertical"
        android:textColor="@color/on_surface" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_two" android:layout_width="match_parent"
        android:layout_height="@dimen/space_48" android:gravity="center_vertical"
        android:textColor="@color/on_surface" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_three" android:layout_width="match_parent"
        android:layout_height="@dimen/space_48" android:gravity="center_vertical"
        android:textColor="@color/on_surface" android:visibility="gone" />
</LinearLayout>
