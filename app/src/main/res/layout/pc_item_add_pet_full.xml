<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width dashed "Add a pet" row, used when the grid is already even (or empty). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_margin="5dp"
    android:background="@drawable/pc_bg_add_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/pc_ic_plus"
        app:tint="@color/pc_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/pc_add_pet"
        android:textAppearance="@style/TextAppearance.PC.RowTitle"
        android:textColor="@color/pc_text_secondary" />
</LinearLayout>
