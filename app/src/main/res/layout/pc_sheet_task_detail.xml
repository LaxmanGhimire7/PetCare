<?xml version="1.0" encoding="utf-8"?>
<!--
    Task detail bottom sheet: what, for whom, when, details, then Mark done / Edit / Share / Delete.
    Covers the brief's edit, delete, mark-complete and delegate requirements from one place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/pc_bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pcSheetIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/pc_bg_oval"
            android:importantForAccessibility="no"
            android:padding="12dp"
            tools:src="@drawable/pc_ic_walk" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pcSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.PC.Headline"
                tools:text="Evening walk" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pcSheetPet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pc_bg_pill"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                    tools:text="Max" />

                <TextView
                    android:id="@+id/pcSheetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/pc_bg_pill"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/TextAppearance.PC.MetaStrong"
                    tools:text="Upcoming" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- When. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/pc_bg_raised_18"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pc_ic_clock"
                app:tint="@color/pc_primary_text" />

            <TextView
                android:id="@+id/pcSheetWhen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.PC.RowTitle"
                tools:text="Fri 25 September at 17:00" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pcSheetRepeatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pc_ic_repeat"
                app:tint="@color/pc_text_secondary" />

            <TextView
                android:id="@+id/pcSheetRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.PC.Supporting"
                tools:text="Every day" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcSheetSuppliesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pc_ic_supplies"
            app:tint="@color/pc_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_supplies"
                android:textAppearance="@style/TextAppearance.PC.Meta" />

            <TextView
                android:id="@+id/pcSheetSupplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAppearance="@style/TextAppearance.PC.Body" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcSheetNotesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pc_ic_notes"
            app:tint="@color/pc_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_notes"
                android:textAppearance="@style/TextAppearance.PC.Meta" />

            <TextView
                android:id="@+id/pcSheetNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAppearance="@style/TextAppearance.PC.Body" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcSheetPlaceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pc_ic_nav_places"
            app:tint="@color/pc_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pc_place"
                android:textAppearance="@style/TextAppearance.PC.Meta" />

            <TextView
                android:id="@+id/pcSheetPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAppearance="@style/TextAppearance.PC.Body" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pcSheetDone"
        style="@style/Widget.PC.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:text="@string/pc_mark_done"
        app:icon="@drawable/pc_ic_check"
        app:iconGravity="textStart" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pcSheetEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pc_bg_raised_16"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/pc_ic_edit"
                app:tint="@color/pc_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/pc_edit"
                android:textAppearance="@style/TextAppearance.PC.Label"
                android:textColor="@color/pc_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pcSheetShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pc_bg_raised_16"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/pc_ic_share"
                app:tint="@color/pc_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/pc_share"
                android:textAppearance="@style/TextAppearance.PC.Label"
                android:textColor="@color/pc_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pcSheetSnooze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pc_bg_raised_16"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/pc_ic_snooze"
                app:tint="@color/pc_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/pc_snooze"
                android:textAppearance="@style/TextAppearance.PC.Label"
                android:textColor="@color/pc_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pcSheetDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pc_bg_raised_16"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/pc_ic_delete"
                app:tint="@color/pc_error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/pc_delete"
                android:textAppearance="@style/TextAppearance.PC.Label"
                android:textColor="@color/pc_error" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
