<?xml version="1.0" encoding="utf-8"?>
<!-- Signs an existing local account in, including optional biometric unlock. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/auth_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_header" android:orientation="vertical"
            android:paddingStart="@dimen/layout_26_dp" android:paddingTop="@dimen/layout_30_dp" android:paddingEnd="@dimen/layout_26_dp" android:paddingBottom="@dimen/layout_64_dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="@dimen/space_48" android:layout_height="@dimen/space_48"
                    app:cardBackgroundColor="@color/hero_button" app:cardCornerRadius="@dimen/layout_17_dp" app:cardElevation="@dimen/layout_zero">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/app_logo"
                        android:padding="@dimen/space_12" android:src="@drawable/ic_pets" app:tint="@color/primary" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/layout_13_dp"
                    android:text="@string/app_name" android:textColor="@color/on_hero" android:textSize="@dimen/layout_23_sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/auth_display_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_36_dp"
                android:text="@string/login_title" android:textColor="@color/on_hero" android:textSize="@dimen/layout_36_sp"
        android:fontFamily="@font/plus_jakarta_sans_extrabold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
                android:text="@string/login_subtitle" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="@color/hero_muted" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/auth_form_card"
            style="@style/Widget.PetCare.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_20" android:layout_marginTop="@dimen/layout_negative_32_dp" android:layout_marginEnd="@dimen/space_20"
            app:cardCornerRadius="@dimen/layout_30_dp" app:cardElevation="@dimen/space_8" app:strokeWidth="@dimen/layout_zero">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/layout_22_dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sign_in"
                    android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/on_surface" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                    android:text="@string/sign_in_helper" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/on_surface_variant" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/email_layout"
                    style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_22_dp" android:hint="@string/email_address" app:startIconDrawable="@drawable/ic_email">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/email_input"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="emailAddress"
                        android:imeOptions="actionNext" android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/password_layout"
                    style="@style/Widget.PetCare.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_14_dp" android:hint="@string/password" app:endIconMode="password_toggle" app:startIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/password_input"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="password"
                        android:imeOptions="actionDone" android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/stay_signed_in_check"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" android:text="@string/stay_signed_in" />
                <com.google.android.material.button.MaterialButton android:id="@+id/sign_in_button"
                    style="@style/Widget.PetCare.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_22_dp" android:text="@string/sign_in" />
                <com.google.android.material.button.MaterialButton android:id="@+id/biometric_button"
                    style="@style/Widget.PetCare.Button.Outlined" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
                    android:text="@string/biometric_unlock" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_14_dp"
                    android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_to_petcare" android:textColor="@color/on_surface_variant" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sign_up_button"
                        style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sign_up" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/space_24"
            android:gravity="center" android:text="@string/auth_privacy_note" android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_surface_variant" />
    </LinearLayout>
</ScrollView>
