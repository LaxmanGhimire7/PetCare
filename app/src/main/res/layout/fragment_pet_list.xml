<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane Pets: compact title, two-column identity cards and a full-width add tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_20">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="@dimen/layout_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pets_screen_title" android:textAppearance="@style/TextAppearance.PetCare.Display" />
        <com.google.android.material.button.MaterialButton android:id="@+id/add_pet_button" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="@dimen/space_40" android:layout_height="@dimen/space_40" android:contentDescription="@string/add_a_pet" app:backgroundTint="@color/surface_raised" app:icon="@drawable/ic_add" app:iconTint="@color/text_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pet_recycler" android:layout_width="match_parent" android:layout_height="@dimen/layout_zero" android:layout_weight="1" android:layout_marginTop="@dimen/space_12" android:clipToPadding="false" android:paddingBottom="@dimen/fab_clearance" />

    <com.google.android.material.button.MaterialButton android:id="@+id/add_pet_tile" style="@style/Widget.PetCare.Button.Text" android:layout_width="match_parent" android:layout_height="@dimen/input_height" android:layout_marginBottom="@dimen/space_16" android:background="@drawable/bg_add_pet_tile" android:text="@string/add_a_pet" app:icon="@drawable/ic_add" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/empty_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:visibility="gone" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="@dimen/radius_header" app:cardElevation="@dimen/layout_zero">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_32">
            <ImageView android:layout_width="@dimen/progress_ring_size" android:layout_height="@dimen/progress_ring_size" android:contentDescription="@null" android:src="@drawable/ic_pets" app:tint="@color/primary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/today_empty_pets_title" android:textAppearance="@style/TextAppearance.PetCare.Section" />
            <com.google.android.material.button.MaterialButton android:id="@+id/empty_add_pet_button" style="@style/Widget.PetCare.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/add_a_pet" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
