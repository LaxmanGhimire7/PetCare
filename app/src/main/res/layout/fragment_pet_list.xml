<?xml version="1.0" encoding="utf-8"?>
<!-- Primary Pets destination with an invitation when no profiles exist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingTop="@dimen/space_24">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pets_screen_title"
        android:textAppearance="@style/TextAppearance.PetCare.Headline" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/pets_screen_subtitle"
        android:textAppearance="@style/TextAppearance.PetCare.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_pet_button" style="@style/Widget.PetCare.Button.Primary"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/add_a_pet" app:icon="@drawable/ic_add" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/empty_card" style="@style/Widget.PetCare.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="@dimen/space_24"
            android:text="@string/pets_empty_invitation"
            android:textAppearance="@style/TextAppearance.PetCare.Body" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pet_recycler"
        android:layout_width="match_parent" android:layout_height="@dimen/layout_zero"
        android:layout_weight="1" android:layout_marginTop="@dimen/space_12"
        android:clipToPadding="false" android:paddingBottom="@dimen/space_24" />
</LinearLayout>
