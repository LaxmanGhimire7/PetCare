<?xml version="1.0" encoding="utf-8"?>
<!-- Pit Lane delegation: caregiver contact, exact message preview, section toggles, and send actions. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/delegation_preview_title" android:textAppearance="@style/TextAppearance.PetCare.Display" />
        <TextView style="@style/MoneySectionTitle" android:text="@string/delegation_contact" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_16">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/caregiver_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/caregiver_name_input"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" android:hint="@string/caregiver_phone">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/caregiver_phone_input"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/pick_contact_button"
                    style="@style/Widget.PetCare.Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="@string/pick_caregiver" app:icon="@drawable/ic_person" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/MoneySectionTitle" android:text="@string/delegation_include" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true">
                <com.google.android.material.chip.Chip android:id="@+id/include_feeding" style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/delegation_feeding" />
                <com.google.android.material.chip.Chip android:id="@+id/include_walks" style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/delegation_walks" />
                <com.google.android.material.chip.Chip android:id="@+id/include_medication" style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/delegation_medication" />
                <com.google.android.material.chip.Chip android:id="@+id/include_notes" style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/delegation_notes" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <TextView style="@style/MoneySectionTitle" android:text="@string/delegation_message_preview" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/caregiver_message">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/message_input"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top"
                android:inputType="textMultiLine|textCapSentences" android:minLines="8" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/send_sms_button"
            style="@style/Widget.PetCare.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24"
            android:text="@string/send_sms" app:icon="@drawable/pc_ic_share" />
        <com.google.android.material.button.MaterialButton android:id="@+id/share_button"
            style="@style/Widget.PetCare.Button.Tonal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/share_other_app" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
