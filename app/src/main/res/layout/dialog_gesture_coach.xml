<?xml version="1.0" encoding="utf-8"?>
<!-- First-run overlay demonstrates the task swipe, drag handle and shake reset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/space_24"
    android:background="?attr/colorSurfaceContainer">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/gesture_coach_title"
        android:textAppearance="@style/TextAppearance.PetCare.Headline" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/gesture_coach_swipe_visual"
        android:gravity="center" android:minHeight="@dimen/space_48"
        android:background="?attr/colorSurface"
        android:textAppearance="@style/TextAppearance.PetCare.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/gesture_coach_swipe"
        android:textAppearance="@style/TextAppearance.PetCare.Body" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/gesture_coach_drag"
        android:textAppearance="@style/TextAppearance.PetCare.Body" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/gesture_coach_shake"
        android:textAppearance="@style/TextAppearance.PetCare.Body" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/gesture_coach_done" style="@style/Widget.PetCare.Button.Primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/gesture_coach_done" />
</LinearLayout>
