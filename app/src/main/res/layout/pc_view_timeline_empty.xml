<?xml version="1.0" encoding="utf-8"?>
<!-- Timeline when the selected day has no tasks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pc_timeline_empty_title"
        android:textAppearance="@style/TextAppearance.PC.RowTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/pc_timeline_empty_body"
        android:textAppearance="@style/TextAppearance.PC.Meta" />
</LinearLayout>
