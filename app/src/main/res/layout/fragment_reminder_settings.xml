<?xml version="1.0" encoding="utf-8"?>
<!-- Sets the default time used when a new care reminder is created. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/layout_36_dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.PetCare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/reminder_settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/reminder_settings_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetCare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_28_dp"
            app:cardBackgroundColor="@color/secondary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_20">

                <ImageView
                    android:layout_width="@dimen/layout_40_dp"
                    android:layout_height="@dimen/layout_40_dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/on_secondary_container" />

                <TextView
                    android:layout_width="@dimen/layout_zero"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:text="@string/reminder_settings_explainer"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_secondary_container" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/default_reminder_time_layout"
            style="@style/Widget.PetCare.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_22_dp"
            android:hint="@string/default_reminder_time"
            app:endIconDrawable="@drawable/ic_alarm"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/default_reminder_time_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/default_reminder_time"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_reminder_settings_button"
            style="@style/Widget.PetCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/save_changes"
            app:icon="@drawable/ic_check"
            app:iconPadding="@dimen/space_8"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</ScrollView>
