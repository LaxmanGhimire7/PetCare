<?xml version="1.0" encoding="utf-8"?>
<!-- Grid pet card: species icon (or photo) on the pet's tint, with a progress ring badge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/pc_bg_surface_20"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/pcPetPhotoFrame"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/pc_bg_round_14">

        <ImageView
            android:id="@+id/pcPetPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pcPetIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/pc_ic_paw"
            tools:tint="@color/pc_primary" />

        <com.example.petcare.design.PetRingView
            android:id="@+id/pcPetRing"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/pcPetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PC.CardTitle"
        tools:text="Max" />

    <TextView
        android:id="@+id/pcPetBreed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PC.Supporting"
        tools:text="Golden retriever" />

    <TextView
        android:id="@+id/pcPetToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.PC.MetaStrong"
        android:textColor="@color/pc_text_secondary"
        tools:text="2 of 3 today" />
</LinearLayout>
